# Referencia de las variables de entorno que recibe el API en el despliegue (Docker, Azure).
# En local se usa appsettings.Development.json. Nunca subir valores reales al repositorio.
ConnectionStrings__ClinicaDental=Host=localhost;Port=5432;Database=clinica_dental;Username=postgres;Password=<contraseña>

# Orígenes permitidos por CORS (uno por índice)
Cors__AllowedOrigins__0=https://<frontend>

# JWT
Jwt__Issuer=ClinicaDentalApi
Jwt__Audience=ClinicaDentalApp
Jwt__Key=<clave aleatoria de al menos 32 bytes en base64>
Jwt__ExpiresInMinutes=120
