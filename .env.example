# Referencia de las variables de entorno que recibe el API en el despliegue (Docker, Azure).
# En local se usa appsettings.Development.json. Nunca subir valores reales al repositorio.

# Supabase por el transaction pooler (puerto 6543): la conexión directa es solo IPv6 y falla desde Docker y Azure.
# GSS Encryption Mode=Disable: la imagen chiseled no trae Kerberos y sin esto se imprime un error inofensivo en el log
ConnectionStrings__ClinicaDental=Host=aws-0-us-east-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.<project-ref>;Password=<contraseña>;SSL Mode=Require;Trust Server Certificate=true;No Reset On Close=true;GSS Encryption Mode=Disable

# Orígenes permitidos por CORS (uno por índice)
Cors__AllowedOrigins__0=https://<frontend>

# JWT
Jwt__Issuer=ClinicaDentalApi
Jwt__Audience=ClinicaDentalApp
Jwt__Key=<clave aleatoria de al menos 32 bytes en base64>
Jwt__ExpiresInMinutes=120
